{
  "name": "domino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DOMINO: an Outbound Desk agent that books meetings on cross-company triggers from the last 30 days, every claim traced to a dated source.",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "demo": "bun scripts/demo.ts",
    "start": "bun scripts/demo.ts",
    "serve": "bun server/index.ts",
    "dev": "bun scripts/dev.ts",
    "build:web": "bun --bun vite build --config web/vite.config.ts",
    "dev:web": "bun --bun vite --config web/vite.config.ts",
    "test": "bun test server",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "bun scripts/smoke.ts",
    "snapshot": "bun scripts/snapshot.ts",
    "wow:flow": "bun --bun vite --config web/wow-flow/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
