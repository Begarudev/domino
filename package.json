{
  "name": "domino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DOMINO: an Outbound Desk agent that books meetings on cross-company triggers from the last 30 days, every claim traced to a dated source.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node scripts/demo.ts",
    "start": "node server/index.ts",
    "dev": "node scripts/dev.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "node --test 'server/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "wow:physical": "vite --config web/wow-physical.vite.config.ts",
    "wow:physical:build": "vite build --config web/wow-physical.vite.config.ts"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@hono/node-server": "^1.13.7",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "hono": "^4.6.14",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.65.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
