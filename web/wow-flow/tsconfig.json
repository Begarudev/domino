{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "noEmit": true, "strict": true, "noUnusedLocals": true, "erasableSyntaxOnly": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "resolveJsonModule": true, "jsx": "react-jsx", "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client"]
  },
  "include": ["./*.tsx", "../src/centrepiece/**/*.ts", "../src/centrepiece/**/*.tsx", "../../shared/types.ts"]
}
